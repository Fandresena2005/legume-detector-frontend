# Chemin vers le fichier du modèle (relatif à la racine du projet)
MODEL_PATH=models/legume_detector_model.h5

# Ordre des classes, séparé par une virgule : CLASS_NAMES[0],CLASS_NAMES[1]
# ⚠️ NON CONFIRMÉ — voir app/config.py et lancez scripts/calibrate.py
# avant de faire confiance à cette valeur.
CLASS_NAMES=sain,pourri

# Origines autorisées pour CORS (séparées par des virgules)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Taille maximale acceptée pour une image, en Mo
MAX_FILE_SIZE_MB=10
